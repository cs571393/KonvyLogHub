import android.content.Context
import android.os.Build
import android.os.Handler
import android.os.Looper
import android.util.Log
import okhttp3.*
import okhttp3.MediaType.Companion.toMediaType
import okhttp3.RequestBody.Companion.toRequestBody
import okio.Buffer
import org.json.JSONArray
import org.json.JSONObject
import java.io.IOException
import java.util.concurrent.TimeUnit

/**
 * Konvy 云端日志工具 (Android 版)
 * 适配 KonvyLogHub V3.0 协议 (含 Socket 监控)
 */
object CloudLogTool {
    private const val TAG = "CloudLogTool"

    // --- 配置区 ---
    private const val WORKER_URL = "https://konvyloghub.pages.dev/report"
    private const val AUTH_TOKEN = "konvy-debug-2026"
    private const val BATCH_INTERVAL = 3000L // 3秒合并一次
    private const val MAX_BATCH_BYTES = 900 * 1024 // 适配单次上报 1MiB 限制

    private val client = OkHttpClient.Builder()
        .connectTimeout(30, TimeUnit.SECONDS)
        .build()

    private var appContext: Context? = null
    private val logBuffer = mutableListOf<JSONObject>()
    private val handler = Handler(Looper.getMainLooper())
    private var lastMetadata: JSONObject? = null
    private var sendRunnable: Runnable? = null

    /**
     * 1. 普通日志上报
     */
    fun log(context: Context, content: Any?, level: String = "info") {
        if (content == null) return
        this.appContext = context.applicationContext
        val logItem = createBaseLog(context, level)
        logItem.put("content", content)

        attachMetadata(context, logItem)
        addToBuffer(logItem)
    }

    /**
     * 2. Socket 专用日志上报
     */
    fun logSocket(context: Context, action: String, content: Any?) {
        this.appContext = context.applicationContext
        val logItem = createBaseLog(context, "socket")
        logItem.put("type", "socket")
        logItem.put("action", action.uppercase())
        logItem.put("content", content ?: "")

        attachMetadata(context, logItem)
        addToBuffer(logItem)
    }

    /**
     * 3. 网络日志上报 (建议使用 Interceptor 自动调用)
     */
    fun logNetwork(
        context: Context,
        url: String,
        method: String,
        requestHeaders: Map<String, String>?,
        requestBody: Any?,
        responseHeaders: Map<String, String>?,
        responseBody: Any?,
        statusCode: Int,
        durationMs: Long
    ) {
        this.appContext = context.applicationContext
        val logItem = createBaseLog(context, "info")
        logItem.put("type", "network")
        logItem.put("method", method.uppercase())
        logItem.put("url", url)
        logItem.put("status", statusCode)
        logItem.put("duration", durationMs)

        val reqObj = JSONObject().apply {
            put("headers", JSONObject(requestHeaders ?: emptyMap<String, String>()))
            put("body", processBody(requestBody))
        }
        val resObj = JSONObject().apply {
            put("headers", JSONObject(responseHeaders ?: emptyMap<String, String>()))
            put("body", processBody(responseBody))
        }

        logItem.put("request", reqObj)
        logItem.put("response", resObj)

        attachMetadata(context, logItem)
        addToBuffer(logItem)
    }

    private fun createBaseLog(context: Context, level: String): JSONObject {
        return JSONObject().apply {
            put("deviceId", getDeviceId(context))
            put("deviceName", "${Build.MANUFACTURER} ${Build.MODEL}")
            put("level", level)
            put("timestamp", System.currentTimeMillis() / 1000.0)
        }
    }

    private fun attachMetadata(context: Context, logItem: JSONObject) {
        val currentMetadata = JSONObject().apply {
            put("user_id", getUserId())
            put("username", getUserName())
            put("imei", getDeviceId(context))
            put("deviceName", "${Build.MANUFACTURER} ${Build.MODEL}")
            put("osVersion", "Android ${Build.VERSION.RELEASE}")
            put("appVersion", getAppVersion(context))
        }

        if (lastMetadata == null || lastMetadata.toString() != currentMetadata.toString()) {
            logItem.put("metadata", currentMetadata)
            lastMetadata = currentMetadata
        }
    }

    private fun addToBuffer(item: JSONObject) {
        synchronized(logBuffer) {
            logBuffer.add(item)
            if (sendRunnable == null) {
                sendRunnable = Runnable { flush() }
                handler.postDelayed(sendRunnable!!, BATCH_INTERVAL)
            }
        }
    }

    private fun flush() {
        val logsToSend: List<JSONObject>
        synchronized(logBuffer) {
            logsToSend = ArrayList(logBuffer)
            logBuffer.clear()
            sendRunnable = null
        }
        if (logsToSend.isNotEmpty()) performUpload(logsToSend)
    }

    private fun performUpload(logs: List<JSONObject>) {
        var currentChunk = JSONArray()
        var currentSize = 0

        for (log in logs) {
            val logStr = log.toString()
            val logBytes = logStr.toByteArray().size

            if (logBytes >= MAX_BATCH_BYTES) continue

            if (currentSize + logBytes > MAX_BATCH_BYTES) {
                sendHttpRequest(currentChunk.toString())
                currentChunk = JSONArray()
                currentSize = 0
            }

            currentChunk.put(log)
            currentSize += logBytes
        }

        if (currentChunk.length() > 0) {
            sendHttpRequest(currentChunk.toString())
        }
    }

    private fun sendHttpRequest(jsonString: String) {
        val request = Request.Builder()
            .url(WORKER_URL)
            .post(jsonString.toRequestBody("application/json".toMediaType()))
            .addHeader("Authorization", AUTH_TOKEN)
            .build()

        client.newCall(request).enqueue(object : Callback {
            override fun onFailure(call: Call, e: IOException) {}
            override fun onResponse(call: Call, response: Response) {
                if (response.isSuccessful) {
                    val bodyStr = response.body?.string()
                    if (!bodyStr.isNullOrEmpty()) {
                        try {
                            val json = JSONObject(bodyStr)
                            json.optJSONArray("commands")?.let { commands ->
                                for (i in 0 until commands.length()) {
                                    handleCommand(commands.getJSONObject(i))
                                }
                            }
                        } catch (e: Exception) {}
                    }
                }
                response.close()
            }
        })
    }

    private fun handleCommand(cmdObj: JSONObject) {
        val command = cmdObj.optString("command")
        val payload = cmdObj.optString("payload")
        if (command == "copy_to_clipboard") {
            handler.post {
                try {
                    val clipboard = appContext?.getSystemService(Context.CLIPBOARD_SERVICE) as? android.content.ClipboardManager
                    val clip = android.content.ClipData.newPlainText("KonvyLogHub", payload)
                    clipboard?.setPrimaryClip(clip)
                } catch (e: Exception) {}
            }
        }
    }

    private fun processBody(body: Any?): Any {
        if (body == null) return ""
        if (body is JSONObject || body is JSONArray) return body
        if (body is String) {
            return try { JSONObject(body) } catch (e: Exception) { try { JSONArray(body) } catch (e2: Exception) { body } }
        }
        if (body is ByteArray) {
            if (body.size > 1024 * 512) return "[Body too large]"
            val str = String(body)
            return try { JSONObject(str) } catch (e: Exception) { str }
        }
        return body.toString()
    }

    private fun getDeviceId(context: Context): String = android.provider.Settings.Secure.getString(context.contentResolver, android.provider.Settings.Secure.ANDROID_ID) ?: "unknown"
    private fun getUserId(): String = ""
    private fun getUserName(): String = ""
    private fun getAppVersion(context: Context): String = try { context.packageManager.getPackageInfo(context.packageName, 0).versionName } catch (e: Exception) { "unknown" }

    /**
     * OkHttp 拦截器：自动捕获所有网络请求
     */
    class Interceptor(private val context: Context) : okhttp3.Interceptor {
        override fun intercept(chain: okhttp3.Interceptor.Chain): Response {
            val request = chain.request()
            val startTime = System.nanoTime()
            val response = chain.proceed(request)
            val durationMs = TimeUnit.NANOSECONDS.toMillis(System.nanoTime() - startTime)

            if (!request.url.toString().contains("konvyloghub")) {
                val reqBody = request.body?.let { body ->
                    val buffer = Buffer()
                    body.writeTo(buffer)
                    buffer.readByteArray()
                }
                val resBody = response.peekBody(1024 * 512).bytes()

                logNetwork(
                    context,
                    request.url.toString(),
                    request.method,
                    request.headers.toMap(),
                    reqBody,
                    response.headers.toMap(),
                    resBody,
                    response.code,
                    durationMs
                )
            }
            return response
        }
    }
}
